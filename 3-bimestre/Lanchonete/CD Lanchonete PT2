import json
from datetime import datetime

ARQUIVO = "dados.json"

try:
    with open(ARQUIVO, "r", encoding="utf-8") as arquivo:
        dados = json.load(arquivo)
except FileNotFoundError:
    dados = {"produtos": [], "pedidos": []}


def salvar():
    with open(ARQUIVO, "w", encoding="utf-8") as arquivo:
        json.dump(dados, arquivo, ensure_ascii=False, indent=4)


def cadastrar():
    nome = input("Nome: ")
    preco = float(input("Preço: R$ "))
    estoque = int(input("Estoque: "))

    dados["produtos"].append({
        "id": len(dados["produtos"]) + 1,
        "nome": nome,
        "preco": preco,
        "estoque": estoque
    })
    salvar()
    print("Produto cadastrado!")


def listar():
    for p in dados["produtos"]:
        print(f'{p["id"]} - {p["nome"]} - R$ {p["preco"]:.2f} - Estoque: {p["estoque"]}')


def pedido():
    nome_cliente = input("Nome do cliente: ")
    listar()
    id_produto = int(input("ID: "))
    quantidade = int(input("Quantidade: "))

    for p in dados["produtos"]:
        if p["id"] == id_produto:
            if quantidade <= p["estoque"]:
                total = p["preco"] * quantidade
                p["estoque"] -= quantidade

                dados["pedidos"].append({
                    "cliente": nome_cliente,
                    "produto": p["nome"],
                    "quantidade": quantidade,
                    "total": total,
                    "data": datetime.now().strftime("%d/%m/%Y %H:%M")
                })

                salvar()
                print(f"Pedido realizado! Total: R$ {total:.2f}")
            else:
                print("Estoque insuficiente.")
            return

    print("Produto não encontrado.")


def alterar_preco():
    listar()
    id_produto = int(input("ID do produto: "))
    
    for p in dados["produtos"]:
        if p["id"] == id_produto:
            p["preco"] = float(input("Novo preço: R$ "))
            salvar()
            print("Preço alterado!")
            return

    print("Produto não encontrado.")


def remover():
    listar()
    id_produto = int(input("ID do produto: "))

    for p in dados["produtos"]:
        if p["id"] == id_produto:
            dados["produtos"].remove(p)
            salvar()
            print("Produto removido!")
            return

    print("Produto não encontrado.")


def pesquisar():
    nome = input("Nome do produto: ").lower()

    for p in dados["produtos"]:
        if nome in p["nome"].lower():
            print(f'{p["id"]} - {p["nome"]} - R$ {p["preco"]:.2f} - Estoque: {p["estoque"]}')


def relatorio():
    print("\n--- RELATÓRIO DE VENDAS ---")
    total = 0

    for p in dados["pedidos"]:
        print(f'{p["cliente"]} - {p["produto"]} - {p["quantidade"]} - R$ {p["total"]:.2f}')
        total += p["total"]

    print(f"Total vendido: R$ {total:.2f}")


while True:
    print("""
===== LANCHONETE =====
1 - Cadastrar produto
2 - Listar produtos
3 - Fazer pedido
4 - Alterar preço
5 - Remover produto
6 - Pesquisar produto
7 - Relatório de vendas
8 - Sair
""")

    opcao = input("Opção: ")

    if opcao == "1":
        cadastrar()
    elif opcao == "2":
        listar()
    elif opcao == "3":
        pedido()
    elif opcao == "4":
        alterar_preco()
    elif opcao == "5":
        remover()
    elif opcao == "6":
        pesquisar()
    elif opcao == "7":
        relatorio()
    elif opcao == "8":
        print("Sistema encerrado.")
        break
    else:
        print("Opção inválida.")
